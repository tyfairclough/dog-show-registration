DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/your_database"
ADMIN_USERNAME="admin_username"
# bcrypt hash — generate with: node scripts/generate-password-hash.js
ADMIN_PASSWORD_HASH="\$"

# Mailtrap Email Sandbox: numeric inbox id + API token (Api-Token header). Either name works:
MAILTRAP_API_TOKEN=
# MAIL_TRAP_API_TOKEN=
MAILTRAP_SANDBOX_INBOX_ID=
# MAILTRAP_DOMAIN is not read by the app — the sandbox API host is fixed (sandbox.api.mailtrap.io).
EMAIL_FROM=
ADMIN_REGISTRATION_EMAIL=
APP_BASE_URL=
