DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/your_database"
# Production (shared hosting): if Prisma logs "pool timeout" with active=0 idle=0, try:
# DATABASE_IPV4_LOCALHOST=true   # when MySQL is on the same server and host is "localhost" (Node may use IPv6 ::1)
# DATABASE_SSL=true              # when the provider requires TLS to MySQL
# DATABASE_SSL_REJECT_UNAUTHORIZED=true  # optional: enforce CA verification (default without this is permissive for shared SSL)
# DATABASE_CONNECT_TIMEOUT_MS=20000
# DATABASE_ACQUIRE_TIMEOUT_MS=20000
ADMIN_USERNAME="admin_username"
# bcrypt hash — generate with: node scripts/generate-password-hash.js
ADMIN_PASSWORD_HASH="\$"

# Mailtrap Email Sandbox: numeric inbox id + API token (Api-Token header). Either name works:
MAILTRAP_API_TOKEN=
# MAIL_TRAP_API_TOKEN=
MAILTRAP_SANDBOX_INBOX_ID=
# MAILTRAP_DOMAIN is not read by the app — the sandbox API host is fixed (sandbox.api.mailtrap.io).
EMAIL_FROM=
ADMIN_REGISTRATION_EMAIL=
APP_BASE_URL=
