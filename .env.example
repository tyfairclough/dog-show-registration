# Copy to `.env.local` for local development (never commit `.env` or `.env.local`).
# Production: set these variables in your host’s dashboard or server environment only.

# -----------------------------------------------------------------------------
# DATABASE_URL (required)
# -----------------------------------------------------------------------------
# One URL for both local and production — each environment sets its own value.
#
# Format:
#   mysql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Production notes:
# - Use the MySQL hostname from your provider (often not "localhost" if the app runs
#   outside that host, e.g. serverless — see hosting docs for remote MySQL access).
# - URL-encode special characters in USER and PASSWORD (e.g. ! → %21, @ → %40).
#
# Example (placeholders only):
# DATABASE_URL="mysql://db_user:encoded_password@mysql.example.com:3306/db_name"

DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/your_database"

# -----------------------------------------------------------------------------
# Auth (set strong values in production)
# -----------------------------------------------------------------------------
# JWT: use a long random string (32+ characters).
JWT_SECRET=

# Required: app startup will fail if ADMIN_USERNAME is not set.
ADMIN_USERNAME=
# Required: app startup will fail if ADMIN_PASSWORD_HASH is not set.
# bcrypt hash — generate with: node scripts/generate-password-hash.js
# Escape '$' as '\$' in .env files so the full bcrypt hash is preserved.
ADMIN_PASSWORD_HASH=

# -----------------------------------------------------------------------------
# Registration emails (Mailgun)
# -----------------------------------------------------------------------------
# If MAILGUN_API_KEY or MAILGUN_DOMAIN is unset, confirmation emails are logged
# to the server console only (useful for local dev).
#
# Mailgun: Basic auth user is always "api"; password is your private API key
# (Sending → your domain → API keys). Do not use a fake hex string — use the real key.
MAILGUN_API_KEY=
# Sending domain (e.g. mg.example.com) — used in POST .../v3/<domain>/messages
MAILGUN_DOMAIN=
# Optional: set to "eu" or "us" to force one API host. If unset, the app tries US
# then EU when the first request returns 401 (common when the domain is on EU).
# MAILGUN_REGION=eu

# From address allowed for MAILGUN_DOMAIN, e.g. Registrations <noreply@mg.example.com>
EMAIL_FROM=

# Recipient for "new registration" admin notifications (omit to skip that email).
ADMIN_REGISTRATION_EMAIL=

# Public site URL for links in emails (no trailing slash), e.g. https://your-site.com
# You can use APP_BASE_URL or NEXT_PUBLIC_APP_URL (first non-empty wins).
# Falls back to https://VERCEL_URL when set (Vercel deploys), else http://localhost:3000
APP_BASE_URL=
# NEXT_PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# Optional — PDF generation on Linux / Docker
# -----------------------------------------------------------------------------
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# -----------------------------------------------------------------------------
# First-time production database schema
# -----------------------------------------------------------------------------
# Pick one:
#   A) Import scripts/mysql-init-etd-show.sql via phpMyAdmin (or mysql CLI), then deploy.
#   B) With DATABASE_URL pointing at an empty database, run once: npm run db:push
# After schema exists: npm run build (postinstall runs prisma generate).
